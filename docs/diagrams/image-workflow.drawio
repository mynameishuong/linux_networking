        <mxCell id="n7" value="1. Mở file dạng binary&#10;Kiểm tra size 1 byte..10 MiB" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#3973bd;strokeWidth=2;fontColor=#172b4d;fontFamily=Arial;fontSize=21;spacing=12;" vertex="1" parent="1">
